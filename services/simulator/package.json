    "send": "tsx src/cli/send.ts",
    "watch": "tsx src/cli/watch.ts"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.11.0",
    "@desal/schema": "workspace:*",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4"
  }
}
